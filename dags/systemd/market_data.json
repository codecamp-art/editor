{
  "description": "# Market Data Start/Stop\n\nThis workflow controls market data services.",
  "schedules": {
    "start": "30 6 * * 1-5",
    "stop": "30 18 * * 1-5"
  },
  "command_timeout_seconds": 1800,
  "tags": [
    "remote-workflow",
    "systemd",
    "market-data",
    "ssh"
  ],
  "host_groups": {
    "mds": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "mds-collector.service",
      "environments": {
        "dev": {
          "sudo_user": "mduser_dev",
          "hosts": [
            "dev-mds-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "mduser_qa",
          "hosts": [
            "qa-mds-01.company.net"
          ]
        },
        "prod": {
          "sudo_user": "mduser",
          "hosts": [
            "prod-mds-01.company.net",
            "prod-mds-02.company.net"
          ]
        },
        "dr": {
          "sudo_user": "mduser_dr",
          "hosts": [
            "dr-mds-01.company.net"
          ]
        }
      }
    },
    "gateway": {
      "type": "systemd",
      "platform": "rhel7",
      "service_name": "mds-gateway.service",
      "environments": {
        "dev": {
          "sudo_user": "mdgateway_dev",
          "hosts": [
            "dev-gw-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "mdgateway_qa",
          "hosts": [
            "qa-gw-01.company.net",
            "qa-gw-02.company.net"
          ]
        },
        "prod": {
          "sudo_user": "mdgateway",
          "hosts": [
            "prod-gw-01.company.net",
            "prod-gw-02.company.net"
          ]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "mds_collector",
      "host_group": "mds"
    },
    {
      "task_id": "mds_gateway",
      "host_group": "gateway",
      "depends_on": [
        "mds_collector"
      ]
    }
  ],
  "upstream_dags": {
    "start": [],
    "stop": [
      {
        "dag_id": "trading-platform-stop",
        "task_id": "end",
        "enabled_in_envs": [
          "qa",
          "prod",
          "dr"
        ]
      }
    ]
  }
}
