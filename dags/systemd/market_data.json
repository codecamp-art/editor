{
  "workflow_id": "market_data",
  "title": "Market Data",
  "description": "# Market Data Start/Stop\n\nThis workflow controls market data services.",
  "schedules": {
    "start": "30 6 * * 1-5",
    "stop": "30 18 * * 1-5"
  },
  "command_timeout_seconds": 1800,
  "tags": ["remote-workflow", "systemd", "market-data", "ssh"],
  "environments": {
    "dev": {
      "env_suffix": "_dev",
      "host_groups": {
        "mds": {
          "login_user": "mduser_dev",
          "type": "systemd",
          "hosts": ["dev-mds-01.company.net"]
        },
        "gateway": {
          "login_user": "mdgateway_dev",
          "type": "systemd",
          "hosts": ["dev-gw-01.company.net"]
        }
      }
    },
    "qa": {
      "env_suffix": "_qa",
      "host_groups": {
        "mds": {
          "login_user": "mduser_qa",
          "type": "systemd",
          "hosts": ["qa-mds-01.company.net"]
        },
        "gateway": {
          "login_user": "mdgateway_qa",
          "type": "systemd",
          "hosts": ["qa-gw-01.company.net", "qa-gw-02.company.net"]
        }
      }
    },
    "prod": {
      "env_suffix": "",
      "host_groups": {
        "mds": {
          "login_user": "mduser",
          "type": "systemd",
          "hosts": ["prod-mds-01.company.net", "prod-mds-02.company.net"]
        },
        "gateway": {
          "login_user": "mdgateway",
          "type": "systemd",
          "hosts": ["prod-gw-01.company.net", "prod-gw-02.company.net"]
        }
      }
    },
    "dr": {
      "env_suffix": "_dr",
      "host_groups": {
        "mds": {
          "login_user": "mduser_dr",
          "type": "systemd",
          "hosts": ["dr-mds-01.company.net"]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "mds_collector",
      "host_group": "mds",
      "systemd": {
        "platform": "rhel8",
        "scope": "user",
        "service_name": "mds-collector.service"
      }
    },
    {
      "task_id": "mds_gateway",
      "host_group": "gateway",
      "depends_on": ["mds_collector"],
      "systemd": {
        "platform": "rhel7",
        "scope": "system",
        "service_name": "mds-gateway.service"
      }
    }
  ],
  "upstream_dags": {
    "start": [],
    "stop": [
      {
        "dag_id": "trading-platform-stop",
        "task_id": "end",
        "enabled_in_envs": ["qa", "prod", "dr"]
      }
    ]
  }
}
