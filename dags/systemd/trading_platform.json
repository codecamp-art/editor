{
  "workflow_id": "trading_platform",
  "title": "Trading Platform",
  "description": "# Trading Platform Start/Stop\n\nThis workflow controls trading platform services and scripts across remote Linux and Windows servers.",
  "schedules": {
    "start": "0 7 * * 1-5",
    "stop": "0 19 * * 1-5"
  },
  "fields": {},
  "command_timeout_seconds": 1800,
  "tags": ["remote-workflow", "systemd", "trading-platform", "ssh"],
  "environments": {
    "dev": {
      "env_suffix": "_dev",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser_dev",
          "hosts": ["dev-gw-01.company.net"]
        },
        "mds": {
          "login_user": "mdsuser_dev",
          "hosts": ["dev-mds-01.company.net"]
        },
        "app_primary": {
          "login_user": "appuser_dev",
          "hosts": ["dev-app-01.company.net"]
        }
      }
    },
    "qa": {
      "env_suffix": "_qa",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser_qa",
          "hosts": ["qa-gw-01.company.net", "qa-gw-02.company.net"]
        },
        "mds": {
          "login_user": "mdsuser_qa",
          "hosts": ["qa-mds-01.company.net"]
        },
        "app_primary": {
          "login_user": "appuser_qa",
          "hosts": ["qa-app-01.company.net"]
        },
        "app_secondary": {
          "login_user": "appuser_qa",
          "hosts": ["qa-app-02.company.net"]
        }
      }
    },
    "prod": {
      "env_suffix": "",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser",
          "hosts": ["prod-gw-01.company.net", "prod-gw-02.company.net"]
        },
        "mds": {
          "login_user": "mdsuser",
          "hosts": ["prod-mds-01.company.net", "prod-mds-02.company.net"]
        },
        "app_primary": {
          "login_user": "appuser",
          "hosts": ["prod-app-01.company.net"]
        },
        "app_secondary": {
          "login_user": "appuser_backup",
          "hosts": ["prod-app-02.company.net"]
        }
      }
    },
    "dr": {
      "env_suffix": "_dr",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser_dr",
          "hosts": ["dr-gw-01.company.net"]
        },
        "mds": {
          "login_user": "mdsuser_dr",
          "hosts": ["dr-mds-01.company.net"]
        },
        "app_primary": {
          "login_user": "appuser_dr",
          "hosts": ["dr-app-01.company.net"]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "gateway",
      "type": "systemd",
      "host_group": "gateway",
      "systemd": {
        "platform": "rhel7",
        "scope": "system",
        "service_name": "gateway.service"
      }
    },
    {
      "task_id": "mds",
      "type": "systemd",
      "host_group": "mds",
      "depends_on": ["gateway"],
      "systemd": {
        "platform": "rhel8",
        "scope": "user",
        "service_name": "mds.service"
      }
    }
  ],
  "task_groups": [
    {
      "group_id": "application_stack",
      "tooltip": "Primary and secondary application services",
      "depends_on": ["mds"],
      "tasks": [
        {
          "task_id": "app_primary",
          "type": "systemd",
          "host_group": "app_primary",
          "systemd": {
            "platform": "rhel8",
            "scope": "user",
            "service_name": "app-primary.service"
          }
        },
        {
          "task_id": "app_secondary",
          "type": "systemd",
          "host_group": "app_secondary",
          "depends_on": ["app_primary"],
          "enabled_in_envs": ["qa", "prod"],
          "optional": true,
          "systemd": {
            "platform": "rhel8",
            "scope": "user",
            "service_name": "app-secondary.service"
          }
        }
      ]
    }
  ],
  "upstream_dags": {
    "start": [
      {
        "dag_id": "market-data-start",
        "task_id": "end",
        "enabled_in_envs": ["qa", "prod", "dr"]
      },
      {
        "dag_id": "reference-data-start",
        "task_id": "end",
        "enabled_in_envs": ["prod"]
      }
    ],
    "stop": []
  }
}
