{
  "workflow_id": "example_platform",
  "register_dags": false,
  "title": "Example Platform",
  "description": "# Example Platform Start/Stop\n\nExample only. This file demonstrates a complete self-contained system workflow config.",
  "owner": "example_owner",
  "schedules": {
    "start": "0 6 * * 1-5",
    "stop": "0 20 * * 1-5"
  },
  "command_timeout_seconds": 1800,
  "tags": ["remote-workflow", "example"],
  "fields": {},
  "environments": {
    "dev": {
      "env_suffix": "_dev",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser_dev",
          "hosts": ["dev-gw-01.company.net"]
        },
        "pricing": {
          "login_user": "pricing_dev",
          "hosts": ["dev-pricing-01.company.net"]
        },
        "risk": {
          "login_user": "risk_dev",
          "hosts": ["dev-risk-01.company.net"]
        }
      }
    },
    "qa": {
      "env_suffix": "_qa",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser_qa",
          "hosts": ["qa-gw-01.company.net", "qa-gw-02.company.net"]
        },
        "pricing": {
          "login_user": "pricing_qa",
          "hosts": ["qa-pricing-01.company.net"]
        },
        "risk": {
          "login_user": "risk_qa",
          "hosts": ["qa-risk-01.company.net"]
        },
        "windows_adapter": {
          "hosts": ["qa-win-adapter-01.company.net"]
        }
      }
    },
    "prod": {
      "env_suffix": "",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser",
          "hosts": [
            {"host": "prod-gw-01.company.net", "login_user": "gwuser_primary"},
            {"host": "prod-gw-02.company.net", "login_user": "gwuser_secondary"}
          ]
        },
        "pricing": {
          "login_user": "pricing",
          "hosts": ["prod-pricing-01.company.net", "prod-pricing-02.company.net"]
        },
        "risk": {
          "login_user": "risk",
          "hosts": ["prod-risk-01.company.net"]
        },
        "backup": {
          "login_user": "backup",
          "hosts": ["prod-backup-01.company.net"]
        },
        "windows_adapter": {
          "hosts": ["prod-win-adapter-01.company.net"]
        }
      }
    },
    "dr": {
      "env_suffix": "_dr",
      "host_groups": {
        "gateway": {
          "login_user": "gwuser_dr",
          "hosts": ["dr-gw-01.company.net"]
        },
        "pricing": {
          "login_user": "pricing_dr",
          "hosts": ["dr-pricing-01.company.net"]
        },
        "risk": {
          "login_user": "risk_dr",
          "hosts": ["dr-risk-01.company.net"]
        },
        "backup": {
          "login_user": "backup_dr",
          "hosts": ["dr-backup-01.company.net"]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "gateway_rhel7",
      "type": "systemd",
      "host_group": "gateway",
      "systemd": {
        "platform": "rhel7",
        "scope": "system",
        "service_name": "gateway.service"
      }
    }
  ],
  "task_groups": [
    {
      "group_id": "backend_services",
      "tooltip": "RHEL8 services and Linux scripts with internal dependencies",
      "depends_on": ["gateway_rhel7"],
      "tasks": [
        {
          "task_id": "pricing_rhel8",
          "type": "systemd",
          "host_group": "pricing",
          "systemd": {
            "platform": "rhel8",
            "scope": "user",
            "service_name": "pricing.service"
          },
          "env_overrides": {
            "prod": {
              "systemd": {
                "service_name": "pricing-prod.service"
              }
            }
          }
        },
        {
          "task_id": "risk_linux_script",
          "type": "linux_script",
          "host_group": "risk",
          "working_dir": "/opt/risk/current",
          "depends_on": ["pricing_rhel8"],
          "remote_env_vars": {
            "APP_ENV": "{env}",
            "APP_LOC": "{loc}"
          },
          "commands": {
            "start": "./bin/risk-control start --env {env}",
            "stop": "./bin/risk-control stop --env {env}",
            "status": "./bin/risk-control status --env {env}"
          }
        },
        {
          "task_id": "ha_backup",
          "type": "systemd",
          "host_group": "backup",
          "depends_on": ["risk_linux_script"],
          "systemd": {
            "platform": "rhel8",
            "scope": "system",
            "service_name": "ha-backup.service"
          }
        }
      ]
    },
    {
      "group_id": "windows_jobs",
      "tooltip": "Windows scripts can be grouped and depend on Linux/systemd tasks",
      "depends_on": ["backend_services"],
      "tasks": [
        {
          "task_id": "windows_adapter",
          "type": "windows_script",
          "host_group": "windows_adapter",
          "windows_shell": "powershell",
          "working_dir": "D:\\Apps\\Adapter",
          "remote_env_vars": {
            "APP_ENV": "{env}"
          },
          "commands": {
            "start": ".\\adapter.ps1 -Action Start -Env $env:APP_ENV",
            "stop": ".\\adapter.ps1 -Action Stop -Env $env:APP_ENV",
            "status": ".\\adapter.ps1 -Action Status -Env $env:APP_ENV"
          }
        }
      ]
    }
  ],
  "upstream_dags": {
    "start": [
      {
        "dag_id": "reference-data-start",
        "task_id": "end",
        "enabled_in_envs": ["qa", "prod"]
      }
    ],
    "stop": [
      {
        "dag_id": "trading-close-check",
        "task_id": "end",
        "enabled_in_envs": ["prod"]
      }
    ]
  }
}
