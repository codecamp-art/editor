{
  "description": "# Example Platform Start/Stop\n\nExample only. This file demonstrates a complete self-contained system workflow config.",
  "schedule_pairs": [
    {
      "start": "0 6 * * 1-5",
      "stop": "0 20 * * 1-5"
    },
    {
      "start": "0 8 * * 6",
      "stop": "0 12 * * 6",
      "enabled_in_envs": [
        "dr"
      ]
    }
  ],
  "command_timeout_seconds": 1800,
  "tags": [
    "remote-workflow",
    "example"
  ],
  "host_groups": {
    "gateway": {
      "type": "systemd",
      "platform": "rhel7",
      "service_name": "gateway{gateway_service_suffix}.service",
      "variables": {
        "gateway_service_suffix": ""
      },
      "environments": {
        "dev": {
          "sudo_user": "gwuser_dev",
          "hosts": [
            "dev-gw-01.company.net"
          ],
          "variables": {
            "gateway_service_suffix": "-dev"
          }
        },
        "qa": {
          "sudo_user": "gwuser_qa",
          "hosts": [
            "qa-gw-01.company.net",
            "qa-gw-02.company.net"
          ],
          "variables": {
            "gateway_service_suffix": "-qa"
          }
        },
        "prod": {
          "sudo_user": "gwuser",
          "hosts": [
            {
              "host": "prod-gw-01.company.net",
              "sudo_user": "gwuser_primary"
            },
            {
              "host": "prod-gw-02.company.net",
              "sudo_user": "gwuser_secondary",
              "platform": "rhel8",
              "service_name": "gateway-secondary.service"
            }
          ]
        },
        "dr": {
          "sudo_user": "gwuser_dr",
          "hosts": [
            "dr-gw-01.company.net"
          ],
          "variables": {
            "gateway_service_suffix": "-dr"
          }
        }
      }
    },
    "pricing": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "pricing{pricing_service_suffix}.service",
      "variables": {
        "pricing_service_suffix": ""
      },
      "environments": {
        "dev": {
          "sudo_user": "pricing_dev",
          "hosts": [
            "dev-pricing-01.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-dev"
          }
        },
        "qa": {
          "sudo_user": "pricing_qa",
          "hosts": [
            "qa-pricing-01.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-qa"
          }
        },
        "prod": {
          "sudo_user": "pricing",
          "hosts": [
            "prod-pricing-01.company.net",
            "prod-pricing-02.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-prod"
          }
        },
        "dr": {
          "sudo_user": "pricing_dr",
          "hosts": [
            "dr-pricing-01.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-dr"
          }
        }
      }
    },
    "risk": {
      "type": "linux_script",
      "sudo_user": "risk_{env}",
      "working_dir": "{risk_root}/{env}/current",
      "variables": {
        "risk_root": "/opt/risk"
      },
      "commands": {
        "start": "./bin/risk-control start --env {env}",
        "stop": "./bin/risk-control stop --env {env}",
        "status": "./bin/risk-control status --env {env}"
      },
      "environments": {
        "dev": {
          "sudo_user": "risk_dev",
          "hosts": [
            "dev-risk-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "risk_qa",
          "hosts": [
            "qa-risk-01.company.net"
          ]
        },
        "prod": {
          "sudo_user": "risk",
          "hosts": [
            "prod-risk-01.company.net"
          ]
        },
        "dr": {
          "sudo_user": "risk_dr",
          "hosts": [
            "dr-risk-01.company.net"
          ]
        }
      }
    },
    "backup": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "ha-backup{backup_service_suffix}.service",
      "variables": {
        "backup_service_suffix": ""
      },
      "environments": {
        "prod": {
          "sudo_user": "backup",
          "hosts": [
            "prod-backup-01.company.net"
          ]
        },
        "dr": {
          "sudo_user": "backup_dr",
          "hosts": [
            "dr-backup-01.company.net"
          ],
          "variables": {
            "backup_service_suffix": "-dr"
          }
        }
      }
    },
    "windows_adapter": {
      "type": "windows_script",
      "commands": {
        "start": ".\\adapter.ps1 -Action Start -Env {env}",
        "stop": ".\\adapter.ps1 -Action Stop -Env {env}",
        "status": ".\\adapter.ps1 -Action Status -Env {env}"
      },
      "environments": {
        "qa": {
          "working_dir": "D:\\Apps\\AdapterQa",
          "hosts": [
            "qa-win-adapter-01.company.net"
          ]
        },
        "prod": {
          "working_dir": "D:\\Apps\\Adapter",
          "hosts": [
            "prod-win-adapter-01.company.net"
          ]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "gateway_rhel7",
      "host_group": "gateway"
    }
  ],
  "task_groups": [
    {
      "group_id": "backend_services",
      "tooltip": "RHEL8 services and Linux scripts with internal dependencies",
      "start_depends_on": [
        "gateway_rhel7"
      ],
      "stop_depends_on": [
        "windows_jobs"
      ],
      "tasks": [
        {
          "task_id": "pricing_rhel8",
          "host_group": "pricing",
          "stop_depends_on": [
            "risk_linux_script"
          ]
        },
        {
          "task_id": "risk_linux_script",
          "host_group": "risk",
          "start_depends_on": [
            "pricing_rhel8"
          ],
          "stop_depends_on": [
            "ha_backup"
          ],
          "remote_env_vars": {
            "APP_ENV": "{env}",
            "APP_LOC": "{loc}"
          }
        },
        {
          "task_id": "ha_backup",
          "host_group": "backup",
          "start_depends_on": [
            "risk_linux_script"
          ]
        }
      ]
    },
    {
      "group_id": "windows_jobs",
      "tooltip": "Windows scripts can be grouped and depend on Linux/systemd tasks",
      "start_depends_on": [
        "backend_services"
      ],
      "stop_depends_on": [
        "gateway_rhel7"
      ],
      "tasks": [
        {
          "task_id": "windows_adapter",
          "host_group": "windows_adapter",
          "windows_shell": "powershell",
          "remote_env_vars": {
            "APP_ENV": "{env}"
          }
        }
      ]
    }
  ],
  "upstream_dags": {
    "start": [
      {
        "dag_id": "reference-data-start",
        "task_id": "end",
        "enabled_in_envs": [
          "qa",
          "prod"
        ]
      }
    ],
    "stop": [
      {
        "dag_id": "trading-close-check",
        "task_id": "end",
        "enabled_in_envs": [
          "prod"
        ]
      }
    ]
  }
}
