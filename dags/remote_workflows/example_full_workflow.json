{
  "description": "# Example Platform Start/Stop\n\nExample only. This file demonstrates a complete self-contained remote workflow config.",
  "runtime_envs": [
    "prod",
    "dr"
  ],
  "schedule_pairs": [
    {
      "start": "0 6 * * 1-5",
      "stop": "0 20 * * 1-5"
    },
    {
      "start": "0 8 * * 6",
      "stop": "0 12 * * 6",
      "enabled_in_envs": [
        "dr"
      ]
    }
  ],
  "command_timeout_seconds": 1800,
  "tags": [
    "remote-workflow",
    "example"
  ],
  "dag_metadata": {
    "start": {
      "description": "Start DAG: runs start order and honors upstream start dependencies.",
      "tags": [
        "start"
      ]
    },
    "stop": {
      "description": "Stop DAG: runs the configured stop order, or the reversed start order when no stop dependencies are defined.",
      "tags": [
        "stop"
      ]
    }
  },
  "generated_task_groups": {
    "shared_app_server": {
      "group_id": "shared_app_server_services",
      "tooltip": "Multiple services and scripts on the same Linux server",
      "start_depends_on": [
        "gateway_rhel7"
      ],
      "stop_depends_on": [
        "backend_services"
      ]
    }
  },
  "host_groups": {
    "gateway": {
      "type": "systemd",
      "platform": "rhel7",
      "service_name": "gateway{gateway_service_suffix}.service",
      "variables": {
        "gateway_service_suffix": ""
      },
      "environments": {
        "dev": {
          "sudo_user": "gwuser_dev",
          "hosts": [
            "dev-gw-01.company.net"
          ],
          "variables": {
            "gateway_service_suffix": "-dev"
          }
        },
        "qa": {
          "sudo_user": "gwuser_qa",
          "platform": "rhel8",
          "service_name": "gateway-qa-user.service",
          "hosts": [
            "qa-gw-01.company.net",
            "qa-gw-02.company.net"
          ],
          "variables": {
            "gateway_service_suffix": "-qa"
          }
        },
        "prod": {
          "sudo_user": "gwuser",
          "hosts": [
            {
              "host": "prod-gw-01.company.net",
              "sudo_user": "gwuser_primary"
            },
            {
              "host": "prod-gw-02.company.net",
              "sudo_user": "gwuser_secondary",
              "platform": "rhel8",
              "service_name": "gateway-secondary.service"
            }
          ]
        },
        "dr": {
          "sudo_user": "gwuser_dr",
          "hosts": [
            "dr-gw-01.company.net"
          ],
          "variables": {
            "gateway_service_suffix": "-dr"
          }
        }
      }
    },
    "pricing": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "pricing{pricing_service_suffix}.service",
      "variables": {
        "pricing_service_suffix": ""
      },
      "environments": {
        "dev": {
          "sudo_user": "pricing_dev",
          "hosts": [
            "dev-pricing-01.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-dev"
          }
        },
        "qa": {
          "sudo_user": "pricing_qa",
          "hosts": [
            "qa-pricing-01.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-qa"
          }
        },
        "prod": {
          "sudo_user": "pricing",
          "hosts": [
            "prod-pricing-01.company.net",
            "prod-pricing-02.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-prod"
          }
        },
        "dr": {
          "sudo_user": "pricing_dr",
          "hosts": [
            "dr-pricing-01.company.net"
          ],
          "variables": {
            "pricing_service_suffix": "-dr"
          }
        }
      }
    },
    "risk": {
      "type": "linux_script",
      "sudo_user": "risk_{env}",
      "working_dir": "{risk_root}/{env}/current",
      "variables": {
        "risk_root": "/opt/risk"
      },
      "commands": {
        "start": "./bin/risk-control start --env {env}",
        "stop": "./bin/risk-control stop --env {env}",
        "status": "./bin/risk-control status --env {env}"
      },
      "fields": {
        "change_ticket": {
          "type": "string",
          "default": "",
          "cli_name": "ticket",
          "export_to_env": true,
          "env_name": "CHANGE_TICKET",
          "description": "Change ticket for start/stop operations."
        },
        "force": {
          "type": "boolean",
          "default": false,
          "cli_name": "force",
          "transform": "lower_bool",
          "description": "Force start/stop when service health checks are stale."
        },
        "phase": {
          "type": "enum",
          "default": "regular",
          "values": [
            "regular",
            "maintenance"
          ],
          "description": "Operational phase for this start/stop run."
        },
        "components": {
          "type": "multi_enum",
          "default": [],
          "values": [
            "engine",
            "scheduler",
            "api"
          ],
          "description": "Risk components to include."
        }
      },
      "remote_env_vars": {
        "APP_ENV": "{env}",
        "APP_LOC": "{loc}"
      },
      "environments": {
        "dev": {
          "sudo_user": "risk_dev",
          "hosts": [
            "dev-risk-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "risk_qa",
          "working_dir": "/opt/risk/qa/current",
          "commands": {
            "start": "./bin/risk-control start --env qa --profile qa",
            "stop": "./bin/risk-control stop --env qa --profile qa",
            "status": "./bin/risk-control status --env qa --profile qa"
          },
          "fields": {
            "phase": {
              "default": "maintenance"
            }
          },
          "preset_params": {
            "components": [
              "engine",
              "api"
            ]
          },
          "remote_env_vars": {
            "APP_LOC": "qa-primary"
          },
          "hosts": [
            "qa-risk-01.company.net"
          ]
        },
        "prod": {
          "sudo_user": "risk",
          "remote_env_vars": {
            "APP_LOC": "prod-primary"
          },
          "hosts": [
            "prod-risk-01.company.net"
          ]
        },
        "dr": {
          "sudo_user": "risk_dr",
          "hosts": [
            "dr-risk-01.company.net"
          ]
        }
      }
    },
    "backup": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "ha-backup{backup_service_suffix}.service",
      "variables": {
        "backup_service_suffix": ""
      },
      "environments": {
        "prod": {
          "sudo_user": "backup",
          "hosts": [
            "prod-backup-01.company.net"
          ]
        },
        "dr": {
          "sudo_user": "backup_dr",
          "hosts": [
            "dr-backup-01.company.net"
          ],
          "variables": {
            "backup_service_suffix": "-dr"
          }
        }
      }
    },
    "shared_app_server": {
      "platform": "rhel8",
      "services": [
        {
          "task_id": "order_api",
          "service_name": "order-api.service",
          "sudo_user": "orderapp"
        },
        {
          "task_id": "position_api",
          "service_name": "position-api.service",
          "sudo_user": "positionapp",
          "start_depends_on": [
            "order_api"
          ]
        }
      ],
      "scripts": [
        {
          "task_id": "warm_cache",
          "type": "linux_script",
          "sudo_user": "cacheops",
          "working_dir": "/opt/cache/{env}/current",
          "commands": {
            "start": "./cache-control start --env {env}",
            "stop": "./cache-control stop --env {env}",
            "status": "./cache-control status --env {env}"
          }
        }
      ],
      "environments": {
        "prod": {
          "services": [
            {
              "task_id": "position_api",
              "sudo_user": "positionapp_prod"
            }
          ],
          "scripts": [
            {
              "task_id": "warm_cache",
              "working_dir": "/opt/cache/prod/current"
            }
          ],
          "hosts": [
            "prod-app-shared-01.company.net"
          ]
        },
        "dr": {
          "services": [
            {
              "task_id": "position_api",
              "sudo_user": "positionapp_dr"
            },
            {
              "task_id": "dr_replay_api",
              "service_name": "dr-replay-api.service",
              "sudo_user": "replayapp"
            }
          ],
          "scripts": [
            {
              "task_id": "warm_cache",
              "working_dir": "/opt/cache/dr/current"
            },
            {
              "task_id": "dr_replay_check",
              "type": "linux_script",
              "sudo_user": "replayops",
              "working_dir": "/opt/replay/dr/current",
              "commands": {
                "start": "./replay-check start --env dr",
                "stop": "./replay-check stop --env dr",
                "status": "./replay-check status --env dr"
              }
            }
          ],
          "hosts": [
            "dr-app-shared-01.company.net"
          ]
        }
      }
    },
    "windows_adapter": {
      "type": "windows_script",
      "windows_shell": "powershell",
      "remote_env_vars": {
        "APP_ENV": "{env}"
      },
      "commands": {
        "start": ".\\adapter.ps1 -Action Start -Env {env}",
        "stop": ".\\adapter.ps1 -Action Stop -Env {env}",
        "status": ".\\adapter.ps1 -Action Status -Env {env}"
      },
      "fields": {
        "adapter_mode": {
          "type": "enum",
          "default": "normal",
          "values": [
            "normal",
            "drain",
            "replay"
          ],
          "description": "Windows adapter start/stop mode."
        },
        "notify": {
          "type": "boolean",
          "default": true,
          "cli_name": "notify",
          "transform": "lower_bool",
          "description": "Send notification after adapter command completes."
        }
      },
      "environments": {
        "qa": {
          "working_dir": "D:\\Apps\\AdapterQa",
          "hosts": [
            "qa-win-adapter-01.company.net"
          ]
        },
        "prod": {
          "working_dir": "D:\\Apps\\Adapter",
          "commands": {
            "start": ".\\adapter.ps1 -Action Start -Env prod -Cluster primary",
            "stop": ".\\adapter.ps1 -Action Stop -Env prod -Cluster primary",
            "status": ".\\adapter.ps1 -Action Status -Env prod -Cluster primary"
          },
          "hosts": [
            "prod-win-adapter-01.company.net"
          ]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "gateway_rhel7",
      "host_group": "gateway"
    }
  ],
  "task_groups": [
    {
      "group_id": "backend_services",
      "tooltip": "RHEL8 services and Linux scripts with internal dependencies",
      "start_depends_on": [
        "gateway_rhel7"
      ],
      "stop_depends_on": [
        "windows_jobs"
      ],
      "tasks": [
        {
          "task_id": "pricing_rhel8",
          "host_group": "pricing",
          "stop_depends_on": [
            "risk_linux_script"
          ]
        },
        {
          "task_id": "risk_linux_script",
          "host_group": "risk",
          "start_depends_on": [
            "pricing_rhel8"
          ],
          "stop_depends_on": [
            "ha_backup"
          ]
        },
        {
          "task_id": "ha_backup",
          "host_group": "backup",
          "start_depends_on": [
            "risk_linux_script"
          ]
        }
      ]
    },
    {
      "group_id": "windows_jobs",
      "tooltip": "Windows scripts can be grouped and depend on Linux/systemd tasks",
      "start_depends_on": [
        "backend_services"
      ],
      "stop_depends_on": [
        "gateway_rhel7"
      ],
      "tasks": [
        {
          "task_id": "windows_adapter",
          "host_group": "windows_adapter"
        }
      ]
    }
  ],
  "upstream_dags": {
    "start": [
      {
        "dag_id": "reference-data-start",
        "task_id": "end",
        "enabled_in_envs": [
          "qa",
          "prod"
        ]
      }
    ],
    "stop": [
      {
        "dag_id": "trading-close-check",
        "task_id": "end",
        "enabled_in_envs": [
          "prod"
        ]
      }
    ]
  }
}
