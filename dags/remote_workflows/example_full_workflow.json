{
  "description": "# Example Platform Start/Stop\n\nExample only. This file demonstrates a complete self-contained remote workflow config.",
  "enabled_in_envs": [
    "dev",
    "qa",
    "prod"
  ],
  "runtime_envs": [
    "prod",
    "dr"
  ],
  "schedule_pairs": [
    {
      "start": "0 6 * * 1-5",
      "stop": "0 20 * * 1-5"
    },
    {
      "start": "0 8 * * 6",
      "stop": "0 12 * * 6",
      "enabled_in_envs": [
        "dr"
      ]
    }
  ],
  "command_timeout_seconds": 1800,
  "runtime_defaults": {
    "sudo_mode": "non_interactive",
    "remote_execution_mode": "auto",
    "systemd_run_scope": "auto",
    "systemd_unit_prefix": "platform-workflow",
    "retry_count": 2,
    "retry_delay_seconds": 10
  },
  "tags": [
    "remote-workflow",
    "example"
  ],
  "dag_metadata": {
    "start": {
      "description": "Start DAG: runs start order and honors upstream start dependencies.",
      "tags": [
        "start"
      ]
    },
    "stop": {
      "description": "Stop DAG: runs explicit stop dependencies, or reversed start order when stop dependencies are not defined.",
      "tags": [
        "stop"
      ]
    },
    "status": {
      "description": "Status DAG: checks configured service and script status without waiting on workflow dependencies.",
      "tags": [
        "status"
      ]
    }
  },
  "host_groups": {
    "gateway_hosts": {
      "platform": "rhel7",
      "variables": {
        "gateway_service_suffix": ""
      },
      "environments": {
        "dev": {
          "sudo_user": "gwuser_dev",
          "variables": {
            "gateway_service_suffix": "-dev"
          },
          "hosts": [
            {
              "host": "dev-gw-01.company.net",
              "services": [
                {
                  "id": "gateway",
                  "service_name": "gateway{gateway_service_suffix}.service"
                }
              ]
            }
          ]
        },
        "qa": {
          "sudo_user": "gwuser_qa",
          "platform": "rhel8",
          "variables": {
            "gateway_service_suffix": "-qa"
          },
          "hosts": [
            {
              "host": "qa-gw-01.company.net",
              "services": [
                {
                  "id": "gateway",
                  "service_name": "gateway{gateway_service_suffix}.service"
                }
              ]
            },
            {
              "host": "qa-gw-02.company.net",
              "services": [
                {
                  "id": "gateway",
                  "service_name": "gateway{gateway_service_suffix}.service"
                }
              ]
            }
          ]
        },
        "prod": {
          "sudo_user": "gwuser",
          "hosts": [
            {
              "hosts": [
                {
                  "host": "prod-gw-01.company.net",
                  "sudo_user": "gwuser_primary"
                },
                {
                  "host": "prod-gw-02.company.net",
                  "sudo_user": "gwuser_secondary"
                }
              ],
              "services": [
                {
                  "id": "gateway",
                  "service_name": "gateway.service"
                }
              ]
            }
          ]
        },
        "dr": {
          "sudo_user": "gwuser_dr",
          "variables": {
            "gateway_service_suffix": "-dr"
          },
          "hosts": [
            {
              "host": "dr-gw-01.company.net",
              "services": [
                {
                  "id": "gateway",
                  "service_name": "gateway{gateway_service_suffix}.service"
                }
              ]
            }
          ]
        }
      }
    },
    "shared_app_hosts": {
      "platform": "rhel8",
      "services": [
        {
          "id": "order_api_{host_id}",
          "systemd_unit_prefix": "order-api",
          "retry_count": 3,
          "service_name": "order-api.service"
        },
        {
          "id": "position_api_{host_id}",
          "service_name": "position-api.service"
        }
      ],
      "scripts": [
        {
          "id": "warm_cache_{host_id}",
          "type": "linux_script",
          "working_dir": "/opt/cache/{env}/current",
          "commands": {
            "start": "./cache-control start --env {env}",
            "stop": "./cache-control stop --env {env}",
            "status": "./cache-control status --env {env}"
          }
        }
      ],
      "environments": {
        "prod": {
          "sudo_user": "shared_app_prod",
          "hosts": [
            {
              "hosts": [
                {
                  "host": "prod-app-shared-01.company.net",
                  "host_id": "prod_app_01"
                },
                {
                  "host": "prod-app-shared-02.company.net",
                  "host_id": "prod_app_02"
                }
              ]
            }
          ],
          "services": [
            {
              "id": "position_api_{host_id}",
              "sudo_user": "positionapp_prod"
            }
          ],
          "scripts": [
            {
              "id": "warm_cache_{host_id}",
              "working_dir": "/opt/cache/prod/current"
            }
          ]
        },
        "dr": {
          "sudo_user": "shared_app_dr",
          "hosts": [
            {
              "host": "dr-app-shared-01.company.net",
              "host_id": "dr_app_01"
            }
          ],
          "services": [
            {
              "id": "position_api_{host_id}",
              "sudo_user": "positionapp_dr"
            },
            {
              "id": "dr_replay_api_{host_id}",
              "service_name": "dr-replay-api.service",
              "sudo_user": "replayapp"
            }
          ],
          "scripts": [
            {
              "id": "warm_cache_{host_id}",
              "working_dir": "/opt/cache/dr/current"
            },
            {
              "id": "dr_replay_check_{host_id}",
              "type": "linux_script",
              "sudo_user": "replayops",
              "working_dir": "/opt/replay/dr/current",
              "commands": {
                "start": "./replay-check start --env dr",
                "stop": "./replay-check stop --env dr",
                "status": "./replay-check status --env dr"
              }
            }
          ]
        }
      }
    },
    "risk_hosts": {
      "type": "linux_script",
      "sudo_user": "risk_{env}",
      "working_dir": "{risk_root}/{env}/current",
      "variables": {
        "risk_root": "/opt/risk"
      },
      "fields": {
        "change_ticket": {
          "type": "string",
          "default": "",
          "cli_name": "ticket",
          "export_to_env": true,
          "env_name": "CHANGE_TICKET",
          "description": "Change ticket for start/stop operations."
        },
        "force": {
          "type": "boolean",
          "default": false,
          "cli_name": "force",
          "transform": "lower_bool",
          "description": "Force start/stop when service health checks are stale."
        },
        "phase": {
          "type": "enum",
          "default": "regular",
          "values": [
            "regular",
            "maintenance"
          ],
          "description": "Operational phase for this start/stop run."
        },
        "components": {
          "type": "multi_enum",
          "default": [],
          "values": [
            "engine",
            "scheduler",
            "api"
          ],
          "description": "Risk components to include."
        }
      },
      "remote_env_vars": {
        "APP_ENV": "{env}",
        "APP_LOC": "{loc}"
      },
      "scripts": [
        {
          "id": "risk_control",
          "commands": {
            "start": "./bin/risk-control start --env {env}",
            "stop": "./bin/risk-control stop --env {env}",
            "status": "./bin/risk-control status --env {env}"
          }
        }
      ],
      "environments": {
        "dev": {
          "sudo_user": "risk_dev",
          "hosts": [
            {
              "host": "dev-risk-01.company.net"
            }
          ]
        },
        "qa": {
          "sudo_user": "risk_qa",
          "working_dir": "/opt/risk/qa/current",
          "commands": {
            "start": "./bin/risk-control start --env qa --profile qa",
            "stop": "./bin/risk-control stop --env qa --profile qa",
            "status": "./bin/risk-control status --env qa --profile qa"
          },
          "fields": {
            "phase": {
              "default": "maintenance"
            }
          },
          "preset_params": {
            "components": [
              "engine",
              "api"
            ]
          },
          "remote_env_vars": {
            "APP_LOC": "qa-primary"
          },
          "hosts": [
            {
              "host": "qa-risk-01.company.net"
            }
          ]
        },
        "prod": {
          "sudo_user": "risk",
          "remote_env_vars": {
            "APP_LOC": "prod-primary"
          },
          "hosts": [
            {
              "host": "prod-risk-01.company.net"
            }
          ]
        },
        "dr": {
          "sudo_user": "risk_dr",
          "hosts": [
            {
              "host": "dr-risk-01.company.net"
            }
          ]
        }
      }
    },
    "backup_hosts": {
      "platform": "rhel8",
      "services": [
        {
          "id": "ha_backup",
          "service_name": "ha-backup{backup_service_suffix}.service"
        }
      ],
      "variables": {
        "backup_service_suffix": ""
      },
      "environments": {
        "prod": {
          "sudo_user": "backup",
          "hosts": [
            {
              "host": "prod-backup-01.company.net"
            }
          ]
        },
        "dr": {
          "sudo_user": "backup_dr",
          "variables": {
            "backup_service_suffix": "-dr"
          },
          "hosts": [
            {
              "host": "dr-backup-01.company.net"
            }
          ]
        }
      }
    },
    "windows_adapter_hosts": {
      "type": "windows_script",
      "windows_shell": "powershell",
      "remote_env_vars": {
        "APP_ENV": "{env}"
      },
      "fields": {
        "adapter_mode": {
          "type": "enum",
          "default": "normal",
          "values": [
            "normal",
            "drain",
            "replay"
          ],
          "description": "Windows adapter start/stop mode."
        },
        "notify": {
          "type": "boolean",
          "default": true,
          "cli_name": "notify",
          "transform": "lower_bool",
          "description": "Send notification after adapter command completes."
        }
      },
      "scripts": [
        {
          "id": "windows_adapter",
          "commands": {
            "start": ".\\adapter.ps1 -Action Start -Env {env}",
            "stop": ".\\adapter.ps1 -Action Stop -Env {env}",
            "status": ".\\adapter.ps1 -Action Status -Env {env}"
          }
        }
      ],
      "environments": {
        "qa": {
          "working_dir": "D:\\Apps\\AdapterQa",
          "hosts": [
            {
              "host": "qa-win-adapter-01.company.net"
            }
          ]
        },
        "prod": {
          "working_dir": "D:\\Apps\\Adapter",
          "commands": {
            "start": ".\\adapter.ps1 -Action Start -Env prod -Cluster primary",
            "stop": ".\\adapter.ps1 -Action Stop -Env prod -Cluster primary",
            "status": ".\\adapter.ps1 -Action Status -Env prod -Cluster primary"
          },
          "hosts": [
            {
              "host": "prod-win-adapter-01.company.net"
            }
          ]
        }
      }
    }
  },
  "tasks": [
    {
      "target": "gateway",
      "task_id": "gateway_rhel7"
    }
  ],
  "task_groups": [
    {
      "group_id": "shared_app_services",
      "tooltip": "Services and scripts on the same Linux app servers",
      "start_depends_on": [
        "gateway_rhel7"
      ],
      "tasks": [
        {
          "targets": [
            "order_api_*"
          ]
        },
        {
          "target": "position_api_prod_app_01",
          "start_depends_on": [
            "order_api_prod_app_01"
          ]
        },
        {
          "target": "position_api_prod_app_02",
          "start_depends_on": [
            "order_api_prod_app_02"
          ]
        },
        {
          "target": "position_api_dr_app_01",
          "start_depends_on": [
            "order_api_dr_app_01"
          ]
        },
        {
          "targets": [
            "warm_cache_*",
            "dr_replay_*"
          ]
        }
      ]
    },
    {
      "group_id": "backend_services",
      "tooltip": "Risk and backup dependencies",
      "start_depends_on": [
        "shared_app_services"
      ],
      "tasks": [
        {
          "target": "risk_control",
          "stop_depends_on": [
            "ha_backup"
          ]
        },
        {
          "target": "ha_backup",
          "start_depends_on": [
            "risk_control"
          ]
        }
      ]
    },
    {
      "group_id": "windows_jobs",
      "tooltip": "Windows scripts can be grouped and depend on Linux/systemd tasks",
      "start_depends_on": [
        "backend_services"
      ],
      "tasks": [
        {
          "target": "windows_adapter"
        }
      ]
    }
  ],
  "upstream_dags": {
    "start": [
      {
        "dag_id": "reference-data-start",
        "task_id": "end",
        "enabled_in_envs": [
          "qa",
          "prod"
        ]
      }
    ],
    "stop": [
      {
        "dag_id": "trading-close-check",
        "task_id": "end",
        "enabled_in_envs": [
          "prod"
        ]
      }
    ]
  }
}
