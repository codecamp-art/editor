{
  "actions": [
    "run"
  ],
  "enabled_in_envs": [
    "dev",
    "qa",
    "prod"
  ],
  "runtime_envs": [
    "prod",
    "dr"
  ],
  "description": "# Daily Batch Workflow\n\nExample only. This file demonstrates a general remote workflow that runs tasks in dependency order without start, stop, or status controls.",
  "schedules": {
    "run": "15 9 * * 1-5"
  },
  "command_timeout_seconds": 1800,
  "runtime_defaults": {
    "sudo_mode": "non_interactive",
    "remote_execution_mode": "auto",
    "systemd_unit_prefix": "batch-workflow",
    "retry_count": 2,
    "retry_delay_seconds": 10
  },
  "tags": [
    "remote-workflow",
    "batch",
    "example"
  ],
  "dag_metadata": {
    "run": {
      "description": "Run DAG: executes the configured task dependency graph.",
      "tags": [
        "run"
      ]
    }
  },
  "host_groups": {
    "batch_linux_hosts": {
      "type": "linux_script",
      "sudo_user": "batch_{env}",
      "working_dir": "/opt/batch/{env}/current",
      "fields": {
        "business_date": {
          "type": "string",
          "default": "",
          "description": "Business date to extract. Leave empty to use scheduler date."
        },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "cli_name": "dry-run",
          "transform": "lower_bool",
          "description": "Run validation without publishing output."
        },
        "region": {
          "type": "enum",
          "default": "us",
          "values": [
            "us",
            "emea",
            "apac"
          ],
          "export_to_env": true,
          "env_name": "REGION",
          "description": "Business region."
        },
        "desks": {
          "type": "multi_enum",
          "default": [],
          "values": [
            "fx",
            "rates",
            "credit"
          ],
          "cli_joiner": "|",
          "description": "Desk filters."
        }
      },
      "scripts": [
        {
          "id": "extract_orders_{host_id}",
          "systemd_unit_prefix": "extract-orders",
          "retry_count": 3,
          "commands": {
            "run": "./bin/extract-orders --env {env}"
          }
        }
      ],
      "environments": {
        "dev": {
          "sudo_user": "batch_dev",
          "hosts": [
            {
              "host": "dev-batch-01.company.net",
              "host_id": "dev_batch_01"
            }
          ]
        },
        "qa": {
          "sudo_user": "batch_qa",
          "systemd_runtime_max_seconds": 1200,
          "retry_delay_seconds": 20,
          "fields": {
            "region": {
              "default": "emea",
              "values": [
                "emea",
                "apac"
              ]
            }
          },
          "preset_params": {
            "dry_run": true,
            "desks": [
              "fx",
              "rates"
            ]
          },
          "scripts": [
            {
              "id": "extract_orders_{host_id}",
              "commands": {
                "run": "./bin/extract-orders --env qa --sample-size 1000"
              }
            }
          ],
          "hosts": [
            {
              "host": "qa-batch-01.company.net",
              "host_id": "qa_batch_01"
            }
          ]
        },
        "prod": {
          "sudo_user": "batch",
          "hosts": [
            {
              "hosts": [
                {
                  "host": "prod-batch-01.company.net",
                  "host_id": "prod_batch_01",
                  "systemd_unit_prefix": "extract-orders-primary",
                  "retry_count": 1
                },
                {
                  "host": "prod-batch-02.company.net",
                  "host_id": "prod_batch_02"
                }
              ]
            }
          ]
        },
        "dr": {
          "sudo_user": "batch_dr",
          "hosts": [
            {
              "host": "dr-batch-01.company.net",
              "host_id": "dr_batch_01"
            }
          ]
        }
      }
    },
    "batch_windows_hosts": {
      "type": "windows_script",
      "windows_shell": "powershell",
      "working_dir": "D:\\Apps\\BatchPublisher",
      "scripts": [
        {
          "id": "publish_orders",
          "commands": {
            "run": ".\\publish.ps1 -Env {env}"
          }
        }
      ],
      "fields": {
        "publish_mode": {
          "type": "enum",
          "default": "fast",
          "values": [
            "fast",
            "full"
          ],
          "description": "Publisher mode."
        },
        "notify": {
          "type": "boolean",
          "default": true,
          "cli_name": "notify",
          "transform": "lower_bool",
          "description": "Send downstream notification."
        }
      },
      "environments": {
        "qa": {
          "working_dir": "D:\\Apps\\BatchPublisherQa",
          "hosts": [
            {
              "host": "qa-win-batch-01.company.net"
            }
          ]
        },
        "prod": {
          "hosts": [
            {
              "host": "prod-win-batch-01.company.net"
            }
          ]
        },
        "dr": {
          "working_dir": "D:\\Apps\\BatchPublisherDr",
          "hosts": [
            {
              "host": "dr-win-batch-01.company.net"
            }
          ]
        }
      }
    }
  },
  "task_groups": [
    {
      "group_id": "extractors",
      "tasks": [
        {
          "targets": [
            "extract_orders_*"
          ]
        }
      ]
    }
  ],
  "tasks": [
    {
      "target": "publish_orders",
      "trigger_rule": "none_failed_min_one_success",
      "depends_on": [
        "extractors"
      ]
    }
  ],
  "upstream_dags": {
    "run": [
      {
        "dag_id": "reference-data-refresh",
        "task_id": "end",
        "enabled_in_envs": [
          "qa",
          "prod"
        ]
      }
    ]
  }
}
