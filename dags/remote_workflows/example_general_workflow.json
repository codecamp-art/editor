{
  "actions": [
    "run"
  ],
  "runtime_envs": {
    "enabled_in_envs": [
      "prod"
    ],
    "targets": [
      "prod",
      "dr"
    ]
  },
  "description": "# Daily Batch Workflow\n\nExample only. This file demonstrates a general remote workflow that runs tasks in dependency order without start, stop, or status controls.",
  "schedules": {
    "run": "15 9 * * 1-5"
  },
  "command_timeout_seconds": 1800,
  "tags": [
    "remote-workflow",
    "batch",
    "example"
  ],
  "dag_metadata": {
    "run": {
      "description": "Run DAG: executes the configured task dependency graph.",
      "tags": [
        "run"
      ]
    }
  },
  "host_groups": {
    "extractor": {
      "type": "linux_script",
      "sudo_user": "batch_{env}",
      "working_dir": "/opt/batch/{env}/current",
      "commands": {
        "run": "./bin/extract-orders --env {env}"
      },
      "fields": {
        "business_date": {
          "type": "string",
          "default": "",
          "description": "Business date to extract. Leave empty to use scheduler date."
        },
        "dry_run": {
          "type": "boolean",
          "default": false,
          "cli_name": "dry-run",
          "transform": "lower_bool",
          "description": "Run validation without publishing output."
        },
        "region": {
          "type": "enum",
          "default": "us",
          "values": [
            "us",
            "emea",
            "apac"
          ],
          "export_to_env": true,
          "env_name": "REGION",
          "description": "Business region."
        },
        "desks": {
          "type": "multi_enum",
          "default": [],
          "values": [
            "fx",
            "rates",
            "credit"
          ],
          "cli_joiner": "|",
          "description": "Desk filters."
        }
      },
      "environments": {
        "dev": {
          "sudo_user": "batch_dev",
          "hosts": [
            "dev-batch-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "batch_qa",
          "fields": {
            "region": {
              "default": "emea",
              "values": [
                "emea",
                "apac"
              ]
            }
          },
          "preset_params": {
            "dry_run": true,
            "desks": [
              "fx",
              "rates"
            ]
          },
          "commands": {
            "run": "./bin/extract-orders --env qa --sample-size 1000"
          },
          "hosts": [
            "qa-batch-01.company.net"
          ]
        },
        "prod": {
          "sudo_user": "batch",
          "hosts": [
            "prod-batch-01.company.net",
            "prod-batch-02.company.net"
          ]
        },
        "dr": {
          "sudo_user": "batch_dr",
          "hosts": [
            "dr-batch-01.company.net"
          ]
        }
      }
    },
    "publisher": {
      "type": "windows_script",
      "windows_shell": "powershell",
      "working_dir": "D:\\Apps\\BatchPublisher",
      "commands": {
        "run": ".\\publish.ps1 -Env {env}"
      },
      "fields": {
        "publish_mode": {
          "type": "enum",
          "default": "fast",
          "values": [
            "fast",
            "full"
          ],
          "description": "Publisher mode."
        },
        "notify": {
          "type": "boolean",
          "default": true,
          "cli_name": "notify",
          "transform": "lower_bool",
          "description": "Send downstream notification."
        }
      },
      "environments": {
        "qa": {
          "working_dir": "D:\\Apps\\BatchPublisherQa",
          "hosts": [
            "qa-win-batch-01.company.net"
          ]
        },
        "prod": {
          "hosts": [
            "prod-win-batch-01.company.net"
          ]
        },
        "dr": {
          "working_dir": "D:\\Apps\\BatchPublisherDr",
          "hosts": [
            "dr-win-batch-01.company.net"
          ]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "extract_orders",
      "host_group": "extractor"
    },
    {
      "task_id": "publish_orders",
      "host_group": "publisher",
      "depends_on": [
        "extract_orders"
      ]
    }
  ],
  "upstream_dags": {
    "run": [
      {
        "dag_id": "reference-data-refresh",
        "task_id": "end",
        "enabled_in_envs": [
          "qa",
          "prod"
        ]
      }
    ]
  }
}
