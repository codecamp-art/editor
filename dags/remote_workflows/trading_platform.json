{
  "description": "# Trading Platform Start/Stop\n\nThis workflow controls trading platform services and scripts across remote Linux and Windows servers.",
  "schedules": {
    "start": "0 7 * * 1-5",
    "stop": "0 19 * * 1-5"
  },
  "command_timeout_seconds": 1800,
  "tags": [
    "remote-workflow",
    "systemd",
    "trading-platform",
    "ssh"
  ],
  "host_groups": {
    "gateway": {
      "type": "systemd",
      "platform": "rhel7",
      "service_name": "gateway.service",
      "environments": {
        "dev": {
          "sudo_user": "gwuser_dev",
          "hosts": [
            "dev-gw-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "gwuser_qa",
          "service_name": "gateway-qa.service",
          "hosts": [
            "qa-gw-01.company.net",
            "qa-gw-02.company.net"
          ]
        },
        "prod": {
          "sudo_user": "gwuser",
          "hosts": [
            "prod-gw-01.company.net",
            "prod-gw-02.company.net"
          ]
        },
        "dr": {
          "sudo_user": "gwuser_dr",
          "hosts": [
            "dr-gw-01.company.net"
          ]
        }
      }
    },
    "mds": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "mds.service",
      "environments": {
        "dev": {
          "sudo_user": "mdsuser_dev",
          "hosts": [
            "dev-mds-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "mdsuser_qa",
          "hosts": [
            "qa-mds-01.company.net"
          ]
        },
        "prod": {
          "sudo_user": "mdsuser",
          "hosts": [
            "prod-mds-01.company.net",
            "prod-mds-02.company.net"
          ]
        },
        "dr": {
          "sudo_user": "mdsuser_dr",
          "service_name": "mds-dr.service",
          "hosts": [
            "dr-mds-01.company.net"
          ]
        }
      }
    },
    "app_primary": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "app-primary.service",
      "environments": {
        "dev": {
          "sudo_user": "appuser_dev",
          "hosts": [
            "dev-app-01.company.net"
          ]
        },
        "qa": {
          "sudo_user": "appuser_qa",
          "hosts": [
            "qa-app-01.company.net"
          ]
        },
        "prod": {
          "sudo_user": "appuser",
          "hosts": [
            "prod-app-01.company.net"
          ]
        },
        "dr": {
          "sudo_user": "appuser_dr",
          "hosts": [
            "dr-app-01.company.net"
          ]
        }
      }
    },
    "app_secondary": {
      "type": "systemd",
      "platform": "rhel8",
      "service_name": "app-secondary.service",
      "environments": {
        "qa": {
          "sudo_user": "appuser_qa",
          "hosts": [
            "qa-app-02.company.net"
          ]
        },
        "prod": {
          "sudo_user": "appuser_backup",
          "hosts": [
            "prod-app-02.company.net"
          ]
        }
      }
    }
  },
  "tasks": [
    {
      "task_id": "gateway",
      "host_group": "gateway"
    },
    {
      "task_id": "mds",
      "host_group": "mds",
      "depends_on": [
        "gateway"
      ]
    }
  ],
  "task_groups": [
    {
      "group_id": "application_stack",
      "tooltip": "Primary and secondary application services",
      "depends_on": [
        "mds"
      ],
      "tasks": [
        {
          "task_id": "app_primary",
          "host_group": "app_primary"
        },
        {
          "task_id": "app_secondary",
          "host_group": "app_secondary",
          "depends_on": [
            "app_primary"
          ],
          "enabled_in_envs": [
            "qa",
            "prod"
          ],
          "optional": true
        }
      ]
    }
  ],
  "upstream_dags": {
    "start": [
      {
        "dag_id": "market-data-start",
        "task_id": "end",
        "enabled_in_envs": [
          "qa",
          "prod",
          "dr"
        ]
      },
      {
        "dag_id": "reference-data-start",
        "task_id": "end",
        "enabled_in_envs": [
          "prod"
        ]
      }
    ],
    "stop": []
  }
}
